+static const NVGcolor COLOR_MUSICAL   = nvgRGB(126, 87, 194);
+static const NVGcolor COLOR_SECTION_A = nvgRGB(30, 100, 200);
+static const NVGcolor COLOR_SECTION_B = nvgRGB(210, 110, 20);
